# Reports generated by the Get-*SizeReport scripts. These contain your actual
# library - show titles, file sizes, paths - so they stay local.
*.csv

# Ledgers / run logs, if anyone points DATA_DIR at the repo
*.log
report.csv
reclaim.csv

# collect-inventory.sh output - LAN IPs, MACs, paths, DDNS names
inventory-*.txt

# API keys. The scripts read these from files on the unRAID box
# (/boot/config/plugins/user.scripts/*.key) - never commit one.
*.key
*.secret
.env

# Python
__pycache__/
*.pyc

# Editor / OS
.claude/settings.local.json
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Site-specific notes and plans (device names, IPs) - never published
private/
